# このブランチは Windows へコピーしてそのまま使うため、キャッシュ・モデル・
# 語彙・カメラ合わせ込み値(speak_cache/, *.pt, vocab*.json, calib.json)も
# コミット対象にしている。除外するのは OS や Python 環境に依存して使い回せないものだけ。

# Python(仮想環境やバイトコードは OS ごとに作り直す)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# CoreML への書き出し(compare_coreml の出力。macOS 専用で60MBある)
*.mlpackage

# 書き込み途中の一時ファイル(atomic replace の中間生成物)
calib.json.tmp
explain_cache.json.tmp

# exe のビルド生成物 (build_exe.ps1 の出力。再生成可能で数GBある)
build/
dist/

# exe / XRAnalyze.bat の実行ログ (packaging/launcher.py が書く)
XRAnalyze.log
XRAnalyze.prev.log

# OS
.DS_Store
Thumbs.db
